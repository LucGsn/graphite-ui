{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lucgsn:graphite-ui:questionnaire:1",
  "title": "Questionnaire graphite-ui (version 1)",
  "description": "Contrat d'un questionnaire affichable directement par OnboardingShell / QuestionnaireRenderer. Règles que le schéma seul ne peut pas exprimer (vérifiées par validateQuestionnaire) : identifiants uniques dans tout le document ; une condition showIf ne vise que des questions placées avant ; valeurs de condition cohérentes avec les options et le type de la question visée ; max > min pour une échelle ; maxChoices ≤ nombre de choix.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "sections"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "question": {
      "oneOf": [
        {
          "$ref": "#/$defs/question-single"
        },
        {
          "$ref": "#/$defs/question-multiple"
        },
        {
          "$ref": "#/$defs/question-scale"
        },
        {
          "$ref": "#/$defs/question-short"
        },
        {
          "$ref": "#/$defs/question-long"
        },
        {
          "$ref": "#/$defs/question-number"
        },
        {
          "$ref": "#/$defs/question-date"
        },
        {
          "$ref": "#/$defs/question-ranking"
        }
      ],
      "description": "Le champ « type » choisit la forme : single, multiple, scale, short, long, number, date, ranking."
    },
    "question-single": {
      "type": "object",
      "required": ["id", "type", "label", "options"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "single"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "display": {
          "enum": ["chips", "cards"]
        },
        "allowOther": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "placeholder": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ],
          "description": "Ajoute « Autre, préciser » avec texte libre."
        }
      }
    },
    "question-multiple": {
      "type": "object",
      "required": ["id", "type", "label", "options"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "multiple"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "display": {
          "enum": ["chips", "cards"]
        },
        "allowOther": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "placeholder": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ],
          "description": "Ajoute « Autre, préciser » avec texte libre."
        },
        "maxChoices": {
          "type": "integer",
          "minimum": 1,
          "description": "Nombre maximal de choix (« Autre » compte pour un). Au plus le nombre de choix proposés."
        }
      }
    },
    "question-scale": {
      "type": "object",
      "required": ["id", "type", "label", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "scale"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer",
          "description": "Strictement supérieur à min ; 11 points au plus."
        },
        "minLabel": {
          "type": "string",
          "minLength": 1
        },
        "maxLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question-short": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "short"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "question-long": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "long"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "question-number": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "number"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question-date": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "date"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "min": {
          "type": "string",
          "format": "date"
        },
        "max": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "question-ranking": {
      "type": "object",
      "required": ["id", "type", "label", "options"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Identifiant stable : lettres, chiffres, - et _. Unique dans tout le questionnaire."
        },
        "type": {
          "const": "ranking"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "options": {
          "$ref": "#/$defs/options"
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Valeur stockée dans la réponse. Unique dans la question."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "description": "Clé d'icône (résolue par l'app) ; jamais d'URL ni de code."
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "condition": {
      "description": "Condition d'affichage : un opérateur sur une question précédente, ou une combinaison all (ET) / any (OU).",
      "oneOf": [
        {
          "type": "object",
          "required": ["question"],
          "additionalProperties": false,
          "properties": {
            "question": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "description": "Question visée : doit être placée AVANT celle qui porte la condition."
            },
            "equals": {
              "type": ["string", "number", "boolean"]
            },
            "in": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": ["string", "number", "boolean"]
              }
            },
            "notEmpty": {
              "const": true
            },
            "gt": {
              "type": "number"
            },
            "lt": {
              "type": "number"
            },
            "contains": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": ["equals"],
              "properties": {
                "equals": {
                  "type": ["string", "number", "boolean"]
                }
              }
            },
            {
              "required": ["in"],
              "properties": {
                "in": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": ["string", "number", "boolean"]
                  }
                }
              }
            },
            {
              "required": ["notEmpty"],
              "properties": {
                "notEmpty": {
                  "const": true
                }
              }
            },
            {
              "required": ["gt"],
              "properties": {
                "gt": {
                  "type": "number"
                }
              }
            },
            {
              "required": ["lt"],
              "properties": {
                "lt": {
                  "type": "number"
                }
              }
            },
            {
              "required": ["contains"],
              "properties": {
                "contains": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        }
      ]
    }
  }
}
