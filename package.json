{
  "name": "graphite-ui",
  "version": "0.1.0",
  "description": "Design system neutre (gris purs, couleur réservée aux statuts et aux données) : tokens, composants React, skill Claude.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "workspaces": [
    "showcase"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./themes/omnes.css": "./src/styles/themes/omnes.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "src",
    "tokens",
    "skills",
    "DESIGN.md",
    "README.md"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run dev -w showcase",
    "build": "npm run tokens && npm run build -w showcase",
    "typecheck": "tsc --noEmit && npm run typecheck -w showcase",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "jsdom": "^26",
    "playwright": "^1.50.0",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  }
}
