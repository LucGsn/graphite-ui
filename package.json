{
  "name": "@lucgsn/graphite-ui",
  "version": "0.3.0",
  "description": "Design system neutre (gris purs, couleur réservée aux statuts et aux données) : tokens, composants React, skill Claude.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucGsn/graphite-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "workspaces": [
    "showcase"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./questionnaire": "./src/questionnaire.ts",
    "./questionnaire.schema.json": "./src/lib/questionnaire/questionnaire.schema.json",
    "./styles.css": "./src/styles/index.css",
    "./themes/omnes.css": "./src/styles/themes/omnes.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "src",
    "!src/__tests__",
    "!src/components/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "tokens",
    "skills",
    "DESIGN.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run dev -w showcase",
    "build": "npm run tokens && npm run build -w showcase",
    "typecheck": "tsc --noEmit && npm run typecheck -w showcase",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs",
    "shots:onboarding": "node scripts/screenshots-onboarding.mjs",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "jsdom": "^26",
    "playwright": "^1.50.0",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.2.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  }
}
